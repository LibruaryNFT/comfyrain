# BigWigs packager manifest. https://github.com/BigWigsMods/packager
package-as: ComfyRain

# The packager copies the whole repo into .release/ComfyRain/, but this repo
# keeps the addon one level down in ComfyRain/, so without this the player would
# unzip to Interface/AddOns/ComfyRain/ComfyRain/ and the game would find nothing.
# This lifts the inner folder up to become the addon folder itself.
move-folders:
    ComfyRain/ComfyRain: ComfyRain

enable-nolib-creation: no

# Everything here is a developer tool, a research artifact or a build input.
# None of it belongs in a player's AddOns folder, and the markdown alone is a
# meaningful share of the download.
#
# The generated .tga and .ogg assets are deliberately NOT listed: they are
# gitignored, so they are not in the checkout at all. The release workflow runs
# the build scripts to place them inside ComfyRain/ before the packager runs,
# and then asserts they are there - because the failure mode if that step is
# ever dropped is not a broken build, it is a zip that installs cleanly and
# has no rain and no sound.
ignore:
    - .github
    - build
    - test
    - tools
    - listfile
    - probe-results
    - install.sh
    - RESUME.md
    # Research artifacts and brand deliberation. docs/ and the name prompt both
    # shipped in v0.9.0-alpha, 194KB of API dumps and an internal argument about
    # what to call this, sitting in a player's AddOns folder. Found by unzipping
    # the published artifact, which is the only place it is visible: the
    # directory having the files is not the question, what a player unzips is.
    # The release workflow now fails on any .md that is not README or CHANGELOG.
    # The six dr-prompt/consult-prompt files these lines used to name were
    # deleted from the repo on 2026-10-21, so there is nothing left to ignore.
    - docs
    - ComfyRain/Probe.lua

manual-changelog:
    filename: CHANGELOG.md
    markup-type: markdown
